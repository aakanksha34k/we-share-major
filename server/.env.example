MONGODB_URI=mongodb://127.0.0.1:27017/we-share
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
PORT=5000
NODE_ENV=development

# Where the React app lives. Comma separated list for CORS.
CLIENT_URL=http://localhost:5173
# Public URL used inside emails (reset-password links etc.). Set this in production!
# e.g. https://we-share-major.vercel.app   (if empty, the first non-localhost CLIENT_URL is used)
FRONTEND_URL=

# ------------------------------------------------------------------
# EMAIL (reset password, reminders, complaint replies, announcements)
# Pick ONE option. Test with:  node scripts/testEmail.js yourname@gmail.com
# ------------------------------------------------------------------
# Option A (recommended on Render free plan, works over HTTPS): Brevo
BREVO_API_KEY=
EMAIL_FROM=                      # must be a sender you verified in Brevo

# Option B: any SMTP server (Brevo SMTP, Mailtrap, Zoho ...)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Option C (local development only; Render free blocks SMTP ports): Gmail App Password
EMAIL_USER=your-we-share-gmail@gmail.com
EMAIL_PASS=your-16-character-google-app-password

# Google Identity Services / OAuth Web Client ID
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Razorpay TEST mode only during development
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-test-secret

# Business rules
LATE_FEE_PER_DAY=20
PURCHASE_PAYMENT_HOURS=48        # time a buyer has to pay for an item for SALE
BORROW_PAYMENT_MINUTES=30        # time a borrower has to pay for a LENDING item

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-admin-password
ADMIN_NAME=Administrator
