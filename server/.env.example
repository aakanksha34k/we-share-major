MONGODB_URI=mongodb://127.0.0.1:27017/we-share
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Gmail SMTP sender. Use a Google App Password, not your normal Gmail password.
EMAIL_USER=your-we-share-gmail@gmail.com
EMAIL_PASS=your-16-character-google-app-password

# Google Identity Services / OAuth Web Client ID
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Razorpay TEST mode only during development
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-test-secret

# Business rule for overdue loans
LATE_FEE_PER_DAY=20

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-admin-password
ADMIN_NAME=Administrator
